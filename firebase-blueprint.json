{
  "entities": {
    "AdminUser": {
      "title": "AdminUser",
      "description": "Global administrator privilege record keyed by Firebase Auth UID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "maxLength": 180
        },
        "addedByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "displayName", "email", "addedByUid", "createdAt"]
    },
    "Workspace": {
      "title": "Workspace",
      "description": "Shared collaborative AlloCat workspace configuration, years, departments, and leave types.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "ownerId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "availableYears": {
          "type": "array",
          "description": "Ordered list of configured planning years."
        },
        "selectedYear": {
          "type": "integer"
        },
        "departments": {
          "type": "array",
          "description": "List of active department names."
        },
        "leaveTypes": {
          "type": "object",
          "description": "Map of leave type keys to metadata objects."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "updatedByName": {
          "type": "string",
          "maxLength": 120
        }
      },
      "required": [
        "name",
        "ownerId",
        "availableYears",
        "selectedYear",
        "departments",
        "leaveTypes",
        "createdAt",
        "updatedAt",
        "updatedByUid",
        "updatedByName"
      ]
    },
    "WorkspaceMember": {
      "title": "WorkspaceMember",
      "description": "Team collaborator profile inside a workspace (PII isolated into memberPrivate).",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "photoURL": {
          "type": "string",
          "maxLength": 500
        },
        "role": {
          "type": "string",
          "enum": ["admin", "editor"]
        },
        "joinedVia": {
          "type": "string",
          "enum": ["bootstrap", "invite", "code", "approval"]
        },
        "inviteCode": {
          "type": "string",
          "maxLength": 64
        },
        "inviteId": {
          "type": "string",
          "maxLength": 128
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "displayName",
        "photoURL",
        "role",
        "joinedVia",
        "createdAt",
        "updatedAt"
      ]
    },
    "WorkspaceMemberPrivate": {
      "title": "WorkspaceMemberPrivate",
      "description": "Isolated PII record containing a collaborator's email address.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
