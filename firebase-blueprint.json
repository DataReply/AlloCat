      "required": ["uid", "email", "createdAt", "updatedAt"]
    },
    "JoinCode": {
      "title": "JoinCode",
      "description": "Shareable workspace invite code allowing verified team members to join as editors.",
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 6,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "active": {
          "type": "boolean"
        },
        "createdByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["code", "label", "active", "createdByUid", "createdAt", "updatedAt"]
    },
    "WorkspaceInvite": {
      "title": "WorkspaceInvite",
      "description": "Email-targeted collaborator invitation created by a workspace admin.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 180
        },
        "role": {
          "type": "string",
          "enum": ["admin", "editor"]
        },
        "invitedByUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "email", "role", "invitedByUid", "createdAt", "updatedAt"]
    },
    "JoinRequest": {
      "title": "JoinRequest",
      "description": "Access request submitted by a signed-in user awaiting admin approval.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "email": {
          "type": "string",
          "minLength": 3,
          "maxLength": 180
        },
