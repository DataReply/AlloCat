  "firestore": {
    "/admins/{userId}": {
      "schema": {
        "$ref": "#/entities/AdminUser"
      },
      "description": "Global administrator privilege documents keyed by Firebase Auth UID."
    },
    "/workspaces/{workspaceId}": {
      "schema": {
        "$ref": "#/entities/Workspace"
      },
      "description": "Shared collaborative workspace configuration, years, departments, and leave types."
    },
    "/workspaces/{workspaceId}/members/{userId}": {
      "schema": {
        "$ref": "#/entities/WorkspaceMember"
      },
      "description": "Authorized workspace collaborators (public display info and role)."
    },
    "/workspaces/{workspaceId}/memberPrivate/{userId}": {
      "schema": {
        "$ref": "#/entities/WorkspaceMemberPrivate"
      },
      "description": "Private PII (email) for workspace collaborators."
    },
    "/workspaces/{workspaceId}/joinCodes/{codeId}": {
      "schema": {
        "$ref": "#/entities/JoinCode"
      },
      "description": "Shareable workspace invite codes enabling verified users to join as editors."
    },
    "/workspaces/{workspaceId}/invites/{inviteId}": {
      "schema": {
        "$ref": "#/entities/WorkspaceInvite"
      },
      "description": "Email-based workspace invitations issued by administrators."
    },
    "/workspaces/{workspaceId}/joinRequests/{requestUid}": {
      "schema": {
        "$ref": "#/entities/JoinRequest"
      },
      "description": "Pending access requests from signed-in users awaiting administrator approval."
    },
    "/workspaces/{workspaceId}/people/{personId}": {
      "schema": {
        "$ref": "#/entities/PersonRecord"
      },
      "description": "Workspace team members and capacity profiles."
    },
    "/workspaces/{workspaceId}/clients/{clientId}": {
      "schema": {
        "$ref": "#/entities/ClientRecord"
      },
      "description": "Workspace client accounts."
    },
    "/workspaces/{workspaceId}/projects/{projectId}": {
      "schema": {
        "$ref": "#/entities/ProjectRecord"
      },
      "description": "Workspace client deliverable projects."
    },
    "/workspaces/{workspaceId}/allocations/{allocationId}": {
      "schema": {
        "$ref": "#/entities/AllocationRecord"
      },
      "description": "Annual person-project monthly percentage and status allocations."
    },
    "/workspaces/{workspaceId}/leaves/{leaveId}": {
      "schema": {
        "$ref": "#/entities/LeaveRecord"
      },
      "description": "Scheduled time off and leave entries for workspace team members."
    }
  }
}
